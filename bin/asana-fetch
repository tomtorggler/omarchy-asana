#!/usr/bin/env bash
#
# Fetch the incomplete tasks of your Asana "My tasks" list for the omarchy
# bar widget. Writes a snapshot to the cache file (which the widget watches)
# and prints it to stdout.
#
# Usage: [ASANA_WORKSPACE=<gid|name>] asana-fetch [--quiet]
#
#   ASANA_WORKSPACE  Workspace to read; defaults to the token user's first.
#                    An environment variable, not an option, because options
#                    show in the process list.
#   --quiet          Do not print the snapshot on success.
#
# The token is looked up in this order:
#   1. $ASANA_TOKEN
#   2. GNOME keyring: secret-tool lookup service omarchy-asana
#   3. ${XDG_CONFIG_HOME:-~/.config}/omarchy/asana/token
#
# On failure prints {"error":{"kind":...,"message":...}} and exits non-zero:
#   2 no-token, 3 auth, 4 network, 5 api

set -euo pipefail
source "$(dirname -- "$(readlink -f -- "$0")")/asana-common.sh"

TASK_FIELDS="name,resource_subtype,due_on,assignee_section.name,projects.name,projects.color,num_subtasks,permalink_url,parent.name"

workspace_arg=${ASANA_WORKSPACE:-}
quiet=0

while (($#)); do
  case "$1" in
    --quiet) quiet=1; shift ;;
    -h | --help) sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) fail api "Unknown option '$1'." ;;
  esac
done

require_token

me=$(api GET "/users/me?opt_fields=name,email,workspaces.name") || exit $?

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
printf '%s' "$me" >"$work/me.json"
printf '%s' "$workspace_arg" >"$work/want.txt"

workspace=$(jq -c --rawfile want "$work/want.txt" '
  .data.workspaces as $ws
  | if $want == "" then $ws[0]
    else ($ws | map(select(.gid == $want or (.name | ascii_downcase) == ($want | ascii_downcase))) | .[0])
    end
  | select(. != null)' "$work/me.json")
[[ -n $workspace ]] || fail api "Workspace '${workspace_arg}' not found for this token."
printf '%s' "$workspace" >"$work/workspace.json"
workspace_gid=$(jq -r '.gid' <<<"$workspace")

task_list=$(api GET "/users/me/user_task_list?workspace=$workspace_gid&opt_fields=name") || exit $?
task_list_gid=$(jq -r '.data.gid' <<<"$task_list")

# The sections of "My tasks" in their on-screen order. Asana serves them from
# the project sections endpoint; if that ever stops working the widget falls
# back to the order in which sections first appear in the task list.
sections=$(api_optional GET "/projects/$task_list_gid/sections?opt_fields=name") || sections='{}'
jq -c '.data // []' <<<"$sections" >"$work/sections.json"

offset=""
for page_no in {01..20}; do
  page="$work/page-$page_no.json"
  api GET "/user_task_lists/$task_list_gid/tasks?completed_since=now&limit=100&opt_fields=$TASK_FIELDS${offset:+&offset=$offset}" >"$page" || exit $?
  offset=$(jq -r '.next_page.offset // empty' "$page")
  [[ -n $offset ]] || break
done

snapshot=$(jq -cn \
  --slurpfile me "$work/me.json" \
  --slurpfile workspace "$work/workspace.json" \
  --arg taskListGid "$task_list_gid" \
  --slurpfile sections "$work/sections.json" \
  --slurpfile pages <(cat "$work"/page-*.json) \
  '{
    fetchedAt: (now | todate),
    user: {gid: $me[0].data.gid, name: $me[0].data.name},
    workspace: {gid: $workspace[0].gid, name: $workspace[0].name},
    workspaces: $me[0].data.workspaces,
    taskListGid: $taskListGid,
    sections: $sections[0],
    tasks: [$pages[].data[]]
  }') || fail api "Could not parse the Asana response."

mkdir -p "$CACHE_DIR"
tmp=$(mktemp "$CACHE_DIR/.tasks.XXXXXX")
printf '%s\n' "$snapshot" >"$tmp" && mv -f "$tmp" "$CACHE_FILE"

((quiet)) || printf '%s\n' "$snapshot"
